// OpenCode 2.0: ~/.config/opencode/opencode.jsonc (or <project>/opencode.jsonc)
{
  "plugins": [
    {
      // A local checkout; use "opencode-plugin-cursor" once it is published to npm.
      "package": "/abs/path/to/cursor-opencode-auth/packages/opencode-plugin-cursor",
      "options": {
        // How Cursor runs for cursor/* models: "ask" (read-only, default), "plan" or "agent".
        "mode": "ask",
        // Register only these models instead of everything `agent --list-models` reports.
        // "models": ["auto", "gpt-5.2", "sonnet-4.5"],
        "timeoutMs": 300000
      }
    }
  ],

  // Session titles with a small Cursor model (or: "title": { "disabled": true }).
  // "agents": { "title": { "model": "cursor/haiku-4.5" } },

  // OpenCode 2.0 cannot ask before plugin tools run; hide the ones you do not want.
  "permission": {
    "cursor_cloud_*": "deny"
  }
}
